# Copie este arquivo para ".env" e preencha.
# Porta HTTP do servidor
PORT=3000

# URL pública do servidor (https em produção). Usada no webhook do Mercado Pago
# e no retorno do login Google. Ex: https://capicoin.seudominio.com
PUBLIC_URL=http://127.0.0.1:3000

# Arquivo do banco SQLite
DB_FILE=./data/capicoin.db

# ===== Mercado Pago (PIX) =====
# Access Token de PRODUÇÃO (APP_USR-...) ou de TESTE (TEST-...).
# NUNCA coloque este token dentro do app Android.
MP_ACCESS_TOKEN=
# (opcional) "Assinatura secreta" do webhook, em Suas integrações > Webhooks
MP_WEBHOOK_SECRET=

# ===== Login com Google (opcional) =====
# Crie um "ID do cliente OAuth" do tipo "Aplicativo da Web" no Google Cloud Console
# e cadastre o URI de redirecionamento:  PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Esquema de deep link do app (não mude se não mudar no AndroidManifest)
APP_SCHEME=capicoin
